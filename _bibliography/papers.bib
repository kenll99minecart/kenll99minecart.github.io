@inproceedings{li_portable_2023,
	title = {Portable electrical impedance tomography ({EIT}) system stages non-alcoholic fatty liver disease for potential screening and monitoring at home},
	url = {https://ieeexplore.ieee.org/document/10339955},
	doi = {10.1109/EMBC40787.2023.10339955},
	abstract = {This study demonstrates the feasibility of predicting {NAFLD} using multi-spectral electrical impedance tomography ({EIT}), group source separation, constant reference {EIT} and anthropometric measures. Vibration-controlled Transient Elastography ({VCTE}) Controlled Attenuated Parameter ({CAP}; n = 121) and magnetic resonance imaging-proton density fat fraction ({MRI}-{PDFF}; n = 34) achieved a sensitivity of 70.9\% and specificity of 73.8\% with our {CAP} predicting model and sensitivity of 77.8\% and specificity of 80.0\% with our {MRI}-{PDFF} predicting model. In summary, a portable {EIT} can be a cost-effective and self-administrable alternative for widespread home-based and community-based diagnostic screening and treatment monitoring of {NAFLD}.Clinical Relevance— Portable multi-spectral {EIT} system has the sensitivity and specificity to potentially unlock biomedical imaging in telemedicine for home-based and community-based screening, staging and monitoring for {NAFLD}.},
	eventtitle = {2023 45th Annual International Conference of the {IEEE} Engineering in Medicine \& Biology Society ({EMBC})},
	pages = {1--4},
	booktitle = {2023 45th Annual International Conference of the {IEEE} Engineering in Medicine \& Biology Society ({EMBC})},
	author = {Li, James H.W. and Touboul, Adrien and Zouari, Fedi and Cheung, Pak To and Wei, Ellie and Wong, Eddie C. and Zhou, Iris Y. and Yuen, Man-Fung and Seto, Wai-Kay and Mak, Lung-Yi and Chan, Russell W.},
	urldate = {2025-08-24},
	date = {2023-07},
	note = {{ISSN}: 2694-0604},
	keywords = {Electrical impedance tomography, Impedance measurement, Predictive models, Sensitivity, Sensitivity and specificity, Source separation, Telemedicine},
}

